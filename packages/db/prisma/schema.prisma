// ============================================================================
// SCHOOL ERP — MULTI-TENANT PRISMA SCHEMA
// PostgreSQL | Prisma ORM | 1000+ schools, 100k+ students, millions of records
// One Organization = One School. Auth models below are Better Auth (unmodified).
// ============================================================================

generator clientEsm {
  provider     = "prisma-client"
  output       = "../src/generated/prisma/esm"
  moduleFormat = "esm"
}

generator clientCjs {
  provider     = "prisma-client"
  output       = "../src/generated/prisma/cjs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

generator dbml {
  provider            = "prisma-dbml-generator"
  projectDatabaseType = "PostgreSQL"
}

// ============================================================================
// SECTION 0: BETTER AUTH FOUNDATION (unmodified — do not redesign)
// ============================================================================

model User {
  id               String       @id
  name             String
  email            String
  emailVerified    Boolean      @default(false)
  image            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  twoFactorEnabled Boolean?     @default(false)
  username         String?
  displayUsername  String?
  role             Role?
  banned           Boolean?     @default(false)
  banReason        String?
  banExpires       DateTime?
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]
  teammembers      TeamMember[]
  members          Member[]
  invitations      Invitation[]

  // Reverse relations into school-domain models where a User is the human behind a role
  staffProfile            StaffProfile[]
  guardianProfile         Guardian[]
  studentProfile          StudentProfile[]
  auditLogsActedBy        AuditLog[]           @relation("AuditLogActor")
  studentProfileCreatedBy StudentProfile[]     @relation("StudentProfileCreatedBy")
  studentProfileUpdatedBy StudentProfile[]     @relation("StudentProfileUpdatedBy")
  studentTransferBy       SectionTransferLog[]
  documentsUploadedBy     DocumentRecord[]
  siblingConfirmedBy      SiblingLink[]
  certificatesIssuedBy    Certificate[]
  performanceReviewedBy   PerformanceReview[]
  attendanceMarkedBy      StudentAttendance[]

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?
  activeOrganizationId String?
  activeTeamId         String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

/// One Organization = One School. Every tenant-scoped model carries organizationId.

model Organization {
  id                String             @id
  name              String
  slug              String
  logo              String?
  createdAt         DateTime
  metadata          String?
  organizationroles OrganizationRole[]
  teams             Team[]
  members           Member[]
  invitations       Invitation[]

  // ---- School-domain reverse relations (all tenant-scoped models) ----
  campuses            Campus[]
  gradeLevels         GradeLevel[]
  academicYears       AcademicYear[]
  classSections       ClassSection[]
  subjects            Subject[]
  subjectGroups       SubjectGroup[]
  timetables          Timetable[]
  periods             Period[]
  holidays            Holiday[]
  studentProfiles     StudentProfile[]
  enrollments         StudentEnrollment[]
  guardians           Guardian[]
  staffProfiles       StaffProfile[]
  employeeRecords     EmployeeRecord[]
  attendanceRecords   StudentAttendance[]
  staffAttendance     StaffAttendance[]
  leaveRequests       LeaveRequest[]
  examSessions        ExamSession[]
  examTypes           ExamType[]
  gradeScales         GradeScale[]
  feeStructures       FeeStructure[]
  feeCategories       FeeCategory[]
  invoices            Invoice[]
  receipts            Receipt[]
  routes              TransportRoute[]
  vehicles            Vehicle[]
  hostels             Hostel[]
  hostelRooms         HostelRoom[]
  books               Book[]
  bookIssues          BookIssue[]
  assets              Asset[]
  vendors             Vendor[]
  ledgerEntries       LedgerEntry[]
  salaryStructures    SalaryStructure[]
  payslips            Payslip[]
  notices             Notice[]
  messageLogs         MessageLog[]
  homeworkAssignments Homework[]
  lessonPlans         LessonPlan[]
  schoolEvents        SchoolEvent[]
  disciplinaryRecords DisciplinaryRecord[]
  healthRecords       HealthRecord[]
  documents           DocumentRecord[]
  apiTokens           ApiToken[]
  auditLogs           AuditLog[]
  houses              House[]
  clubs               Club[]
  boards              Board[] // org can define custom boards in addition to global ones

  @@unique([slug])
  @@map("organization")
}

model OrganizationRole {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           SchoolRole
  permission     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt

  @@index([organizationId])
  @@index([role])
  @@map("organizationRole")
}

model Team {
  id             String       @id
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime
  updatedAt      DateTime?    @updatedAt
  teammembers    TeamMember[]

  @@index([organizationId])
  @@map("team")
}

model TeamMember {
  id        String    @id
  teamId    String
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime?

  @@index([teamId])
  @@index([userId])
  @@map("teamMember")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           SchoolRole   @default(STUDENT)
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           SchoolRole?
  teamId         String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

